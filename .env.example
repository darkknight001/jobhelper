# Copy to .env (local) or deploy/.env (server) and fill in. Never commit the real file.

# --- Claude (your subscription) ---
# Run `claude setup-token` on any machine where you're logged in to Claude Code and
# paste the token here. It uses your Pro/Max plan's limits, not API credits.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Dashboard ---
JOBHELPER_DASHBOARD_PASSWORD=
# Random secrets: python -c "import secrets; print(secrets.token_urlsafe(32))"
JOBHELPER_SESSION_SECRET=
JOBHELPER_API_TOKEN=
JOBHELPER_PUBLIC_URL=https://jobs.example.com
JOBHELPER_BIND=127.0.0.1:8095

# --- Credential vault for company career-site logins ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JOBHELPER_VAULT_KEY=

# --- Gmail (IMAP, read-only use) ---
# Google Account → Security → 2-Step Verification → App passwords.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=

# --- Telegram bot (alerts with buttons; your answers) ---
# Create a bot with @BotFather, paste its token, then pair it from the dashboard (Settings).
TELEGRAM_BOT_TOKEN=

# --- Optional: Hermes webhook as a fallback alert channel. Leave empty if you don't run Hermes. ---
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=

# --- Browser ---
# Chromium remote-debugging port the apply agent attaches to (bound to localhost).
JOBHELPER_CDP_PORT=9333
# Set to 1 on a desktop to see the browser window locally; the server runs headed in Xvfb.
JOBHELPER_HEADLESS=0
# Password for the remote browser (noVNC). Without it the remote browser stays locked.
JOBHELPER_VNC_PASSWORD=
